@using SAMACDX.ThemeManager.Persistence.Interfaces.Services.Theme
@using SAMACDX.ThemeManager.Persistence.Entities.ThemeCatalog
@using SAMACDX.ThemeManager.Persistence.Application
@using SAMACDX.ThemeManager.Persistence.Utilities
@using ThemePresetMud = MudBlazor.ThemeManager.MudThemeManager.ThemePreset;


@inject IThemeManagerService ThemeManagerService
@inject IThemePresentService ThemePresentService
@inject ISnackbar SnackbarService

<MudPaper Class="" Style="overflow:hidden; position:relative;">
    <MudDrawerContainer Class="mud-height-full px-6">
        <MudGrid Class="py-2" Justify="Justify.SpaceBetween">
            <MudItem xs="9">
                <MudPaper Class="m-6 p-6" Elevation="0">
                    <MudStack Spacing="2">
                        <MudText Class="pb-2" Typo="Typo.h4">
                            Configurador de Tema Visual
                        </MudText>

                        <MudText Typo="Typo.body1">
                            Personaliza la apariencia de la plataforma ajustando colores, tipografías, elevaciones y estilos de componentes.
                            Los cambios permiten adaptar la interfaz a las necesidades institucionales o preferencias del usuario.
                        </MudText>

                        <MudText Typo="Typo.body2">
                            En la parte <b>izquierda</b> encontrarás un <i>preview</i> en tiempo real que muestra cómo se verá la interfaz al configurar un nuevo tema visual.
                            En la parte <b>derecha</b>, un panel lateral te permitirá <b>guardar el tema</b>, <b>seleccionar configuraciones previas</b>
                            y <b>modificar los colores</b> de los diferentes elementos de la plataforma.
                        </MudText>
                    </MudStack>
                </MudPaper>

            </MudItem>
            <MudItem>
                <MudPaper Elevation="0" Class="px-2 d-flex justify-center flex-wrap" Width="280px">
                    <MudTextField T="string" @bind-Value="nameTheme" Label="Nombre del Tema" Required="true" RequiredError="@nameThemeErrorMessage" Error="@nameThemeError" ErrorText="@nameThemeErrorMessage" Variant="Variant.Text" Clearable="true" AdornmentColor="Color.Primary" Immediate="true" Class="pa-4" />
                    <MudButton Disabled="!ValidateThemeName() || isSavingThemePresent" Variant="Variant.Filled" Color="Color.Primary" OnClick="saveThemePresent">
                        @if (isSavingThemePresent)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <MudText Class="ms-2">Guardando</MudText>
                        }
                        else
                        {
                            <MudText>@(selectedThemePresent is null ? "Guardar Configuración" : "Actualizar Configuración")</MudText>
                        }
                    </MudButton>
                </MudPaper>
            </MudItem>
        </MudGrid>
        <MudThemeManager Theme="themeManagerTheme" ThemeChanged="UpdateTheme" ThemePresets="@themePresets" ThemePresetsChanged="updateThemePreset"
                         OnClickActiveThemePresent="OnClickActiveThemePresent" IsSavingActiveThemeCatalog="@isSavingActiveThemePresent" />
        <div class="d-flex justify-center align-center mud-height-full">
            <ComponentsPreview />
        </div>
    </MudDrawerContainer>
</MudPaper>


@code {

    [Parameter]
    public ThemePresent? ThemePresent { get; set; }

    [Parameter]
    public EventCallback<ThemePresent> SelectThemePresent { get; set; }

    private string? nameTheme;
    private bool nameThemeError = false;
    private string nameThemeErrorMessage = "El campo es obligatorio";
    private bool isSavingThemePresent = false;
    private bool isSavingActiveThemePresent = false;

    private Dictionary<int, ThemePresetMud> themePresets = new Dictionary<int, ThemePresetMud>();
    private List<ThemePresent> themePresents = new List<ThemePresent>();
    private ThemeManagerTheme themeManagerTheme = new ThemeManagerTheme();
    private ThemePresent? activeThemePresent;
    private ThemePresent? selectedThemePresent;

    protected override async Task OnInitializedAsync()
    {       
        try
        {
            await GetThemePresents();
        }
        catch (Exception)
        {
            SnackbarService.Add("No se pudieron cargar los temas guardados.", Severity.Error);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await GetActiveThemeManagerTheme();
            }
            catch (Exception)
            {
                SnackbarService.Add("No se pudo cargar el tema activo.", Severity.Error);
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ThemePresent is null)
        {
            selectedThemePresent = null;
            nameTheme = string.Empty;
            return;
        }

        nameTheme = ThemePresent.Name;
        await updateThemePreset(new ThemePresetMud(ThemePresent.Id, ThemePresent.Name, ThemePresent.IsActive));
    }

    private async Task GetActiveThemeManagerTheme()
    {
        activeThemePresent = await ThemePresentService.GetActiveAsync();

        if (activeThemePresent is null)
        {
            return;
        }

        if (activeThemePresent?.JsonData is null)
        {
            return;
        }

        themeManagerTheme = JsonHelper.Deserialize<ThemeManagerTheme>(activeThemePresent.JsonData)!;

        foreach (var key in themePresets.Keys.ToList())
        {
            var preset = themePresets[key];

            themePresets[key] = preset with { IsActive = key == activeThemePresent.Id };
        }

        StateHasChanged();
    }

    private async Task GetThemePresents()
    {
        themePresents = await ThemePresentService.GetAllAsync();

        themePresets = themePresents.ToDictionary(
            themePresent => themePresent.Id,
            themePresent => new ThemePresetMud(themePresent.Id, themePresent.Name, themePresent.IsActive)
        );
    }

    private async Task UpdateTheme(ThemeManagerTheme updateThemeManagerTheme)
    {
        themeManagerTheme = updateThemeManagerTheme;

        // ChangeTheme ya no lanza si nadie esta suscrito a OnThemeChanged (ver
        // ThemeManagerIntegration/ThemeManagerService.cs), pero de todas
        // formas se espera (await) en vez de "fire-and-forget": antes no se
        // esperaba, lo que dejaba cualquier excepcion futura de un suscriptor
        // como una excepcion de tarea no observada.
        await ThemeManagerService.ChangeTheme(updateThemeManagerTheme);

        StateHasChanged();
    }

    private async Task saveThemePresent()
    {
        if (!ValidateThemeName())
        {
            return;
        }

        isSavingThemePresent = true;

        try
        {
            var themeName = nameTheme!.Trim();
            var existingThemePresent = selectedThemePresent
                ?? themePresents.FirstOrDefault(themePresent => string.Equals(themePresent.Name, themeName, StringComparison.OrdinalIgnoreCase));

            var themeToSave = new ThemePresent
            {
                Id = existingThemePresent?.Id ?? 0,
                Name = themeName,
                JsonData = JsonHelper.Serialize(themeManagerTheme),
                IsActive = existingThemePresent?.IsActive ?? false
            };

            var savedThemePresent = existingThemePresent is null
                ? await ThemePresentService.CreateAsync(themeToSave)
                : await ThemePresentService.UpdateAsync(themeToSave);

            SnackbarService.Add(existingThemePresent is null ? "Tema guardado exitosamente." : "Tema actualizado exitosamente.", Severity.Success);

            await GetThemePresents();

            if (existingThemePresent is not null)
            {
                selectedThemePresent = savedThemePresent;
                await SelectThemePresent.InvokeAsync(savedThemePresent);
            }

            nameTheme = savedThemePresent.Name;
        }
        catch (ThemeValidationException ex)
        {
            nameThemeError = true;
            nameThemeErrorMessage = ex.Message;
        }
        catch (Exception)
        {
            SnackbarService.Add("No se pudo guardar el tema. Intenta nuevamente.", Severity.Error);
        }
        finally
        {
            isSavingThemePresent = false;
        }
    }

    private bool ValidateThemeName()
    {
        if (string.IsNullOrWhiteSpace(nameTheme))
        {
            nameThemeError = true;
            nameThemeErrorMessage = "El nombre del tema no puede estar vacío";
            return false;
        }
        else
        {
            nameThemeError = false;
            return true;
        }
    }

    private async Task updateThemePreset(ThemePresetMud updateThemePreset)
    {
        try
        {
            selectedThemePresent = await ThemePresentService.GetByIdAsync(updateThemePreset.Id);

            if (selectedThemePresent?.JsonData is null)
            {
                SnackbarService.Add("No se encontro la configuracion visual de ese tema.", Severity.Warning);
                return;
            }

            nameTheme = selectedThemePresent.Name;

            ThemeManagerTheme themeManagerTheme = JsonHelper.Deserialize<ThemeManagerTheme>(selectedThemePresent.JsonData)!;

            foreach (var key in themePresets.Keys.ToList())
            {
                var preset = themePresets[key];

                themePresets[key] = preset with { IsActive = key == updateThemePreset.Id };
            }

            await UpdateTheme(themeManagerTheme);
        }
        catch (Exception)
        {
            SnackbarService.Add("No se pudo cambiar la vista previa del tema.", Severity.Error);
        }
    }

    private async Task OnClickActiveThemePresent()
    {
        if (selectedThemePresent is null)
        {
            return;
        }

        isSavingActiveThemePresent = true;

        try
        {
            await ThemePresentService.ActivateAsync(selectedThemePresent.Id);

            await GetActiveThemeManagerTheme();
        }
        catch (Exception)
        {
            SnackbarService.Add("No se pudo activar el tema. Intenta nuevamente.", Severity.Error);
        }
        finally
        {
            isSavingActiveThemePresent = false;
        }
    }
}
