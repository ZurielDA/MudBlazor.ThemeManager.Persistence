@* Antes de esta etapa este componente declaraba @page "/ThemeCatalog" en forma
   fija: cualquier app consumidora quedaba forzada a esa ruta exacta, sin
   poder montarlo en otro path (o localizarlo, o coexistir con una ruta
   propia igual). Ahora es un componente normal, sin ruta propia: el
   consumidor decide donde montarlo, envolviendolo en su propia pagina con
   el @page que prefiera. Ver samples/TestHost/Components/Pages/ThemeCatalogPage.razor
   para el ejemplo (mantiene la misma ruta /ThemeCatalog que tenia antes). *@
@using SAMACDX.ThemeManager.Persistence.Entities.ThemeCatalog

<MudPaper Elevation="0" Class="pt-4">

    <MudTabs Elevation="0" Rounded="true" PanelClass="pt-4" ApplyEffectsToContainer="true">
        <MudTabPanel Text="Identidad">
            <ThemeFaviconAndLogoConfig SelectThemeCatalog="themeCatalog" />
        </MudTabPanel>
        <MudTabPanel Text="Tema visual">
            <ThemePaletteSelector ThemeCatalogChanged="themeCatalogChanged" />
        </MudTabPanel>
        <MudTabPanel Text="Terminología">
            <ThemeTermConfig />
        </MudTabPanel>
    </MudTabs>

</MudPaper>

@code {

    private ThemeCatalog? themeCatalog;

    private void themeCatalogChanged(ThemeCatalog themeCatalogTemp)
    {
        themeCatalog = themeCatalogTemp;        
    }
}
