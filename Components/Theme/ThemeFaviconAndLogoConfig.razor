@using SAMACDX.ThemeManager.Persistence.Interfaces.Services.Theme
@using SAMACDX.ThemeManager.Persistence.Interfaces.Services
@using SAMACDX.ThemeManager.Persistence.Entities.ThemeCatalog
@using SAMACDX.ThemeManager.Persistence.Application
@using SAMACDX.ThemeManager.Persistence.Extensions
@using SAMACDX.ThemeManager.Persistence.StaticAssets
@using System.Text.Json

@inject IThemeFaviconService ThemeFaviconService;
@inject IThemeLogoService ThemeLogoService;
@inject ThemeManagerPersistenceOptions Options
@inject ISnackbar SnackbarService

<MudPaper Class="py-8 my-8" Style="overflow:hidden; position:relative;">
    <MudPaper Class="mx-6 my-6" Elevation="0">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h4">
                Configurador de Favicon y Logo
            </MudText>

            <MudText Typo="Typo.body1">
                Personaliza el favicon y logotipos de la plataforma para alinear la identidad visual con la de tu institución o marca.
                Desde aquí puedes actualizar las imágenes principales y sus variaciones, asegurando una apariencia coherente en toda la interfaz de usuario.
            </MudText>

            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Recomendación: utiliza imágenes en formato <b>SVG</b> para obtener mejor calidad y escalabilidad en distintos dispositivos.
            </MudText>
        </MudStack>
    </MudPaper>
    <MudGrid Class="mx-1">
        @* Sección de Favicon *@
        <MudItem xs="12" sm="6">
            <MudPaper Elevation="1" Class="d-flex align-center justify-center mud-width-full pb-2">
                <MudText Typo="Typo.h6">Favicon</MudText>
            </MudPaper>
            <MudPaper Class="d-flex flex-column mud-width-full" Elevation="1">
                <MudGrid>
                    <MudItem xs="12" md="8">
                        <MudPaper Elevation="0" Class="d-flex align-center justify-center mud-width-full pt-4">
                            <MudAvatar Rounded="true" Variant="Variant.Outlined" Class="border-none" Style="height:100px; width:auto;">
                                <MudImage Src="@_faviconPreviewPath" />
                            </MudAvatar>
                        </MudPaper>
                        <MudPaper Elevation="0" Class="d-flex align-center justify-center mud-width-full py-4 mt-2">
                            <MudFileUpload T="IBrowserFile" OnFilesChanged="UploadFiles" Accept="image/*" Class="mx-2">
                                <ActivatorContent>
                                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Image" Size="Size.Small" Color="Color.Secondary" Class="rounded-pill">Cargar</MudButton>
                                </ActivatorContent>
                            </MudFileUpload>                                
                            <MudPaper Elevation="4" Class="rounded-pill mx-2">
                                <MudButton Disabled="_faviconFileBytes == null || _isSavingThemeFavicon" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveFaviconAsync" Size="Size.Small" Color="Color.Primary" Class="rounded-pill">
                                    @if (_isSavingThemeFavicon)
                                    {
                                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                        <MudText Class="ms-2">Guardando</MudText>
                                    }
                                    else
                                    {
                                        <MudText>Guardar</MudText>
                                    }                                        
                                </MudButton>
                            </MudPaper>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudPaper Elevation="0" Class="p-4 mt-2">
                            <MudText Typo="Typo.h6">Favicons</MudText>
                            <MudSelect T="int" Label="Favicon Seleccionado" Dense="true" Margin="Margin.Dense" Value="@_activeFaviconId" ValueChanged="OnActivateFaviconAsyncChanged">
                                @foreach (var themeIcon in _themeFavicons)
                                {
                                    <MudSelectItem Value="@themeIcon.Id">@themeIcon.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudPaper>
                        <MudPaper Elevation="0" Class="d-flex align-center justify-center mud-width-full py-4 mt-2">
                            <MudButton OnClick="ActivateFaviconAsync" Disabled="!_hasSelectionChanged || _isActivatingThemeFavicon" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" Color="Color.Error">

                                @if (_isActivatingThemeFavicon)
                                {
                                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                    <MudText Class="ms-2">Activando Favicon</MudText>
                                }
                                else
                                {
                                    <MudText>Activar Favicon</MudText>
                                }

                            </MudButton>
                        </MudPaper>                            
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>
        @* -- *@

        @* Sección de Logotipo *@
        <MudItem xs="12" sm="6">
            <MudPaper Elevation="1" Class="d-flex align-center justify-center mud-width-full pb-2">
                <MudText Typo="Typo.h6">Logo</MudText>
            </MudPaper>
            <MudPaper Class="d-flex flex-column mud-width-full" Elevation="1">
                <MudGrid>
                    <MudItem xs="12" md="8">
                        <MudPaper Elevation="0" Class="d-flex align-center justify-center mud-width-full pt-4">
                            <MudAvatar Rounded="true" Variant="Variant.Outlined" Class="border-none" Style="height:100px; width:auto;">
                                <MudImage Src="@_logoPreviewPath" />
                            </MudAvatar>
                        </MudPaper>
                        <MudPaper Elevation="0" Class="d-flex align-center justify-center mud-width-full py-4 mt-2">
                            <MudFileUpload T="IBrowserFile" OnFilesChanged="UploadLogoFile" Accept="image/png,image/jpeg" Class="mx-2">
                                <ActivatorContent>
                                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Image" Size="Size.Small" Color="Color.Secondary" Class="rounded-pill">Cargar</MudButton>
                                </ActivatorContent>
                            </MudFileUpload>
                            <MudPaper Elevation="4" Class="rounded-pill mx-2">
                                <MudButton Disabled="_logoFileBytes == null || _isSavingThemeLogo" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveLogoAsync" Size="Size.Small" Color="Color.Primary" Class="rounded-pill">
                                    @if (_isSavingThemeLogo)
                                    {
                                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                        <MudText Class="ms-2">Guardando</MudText>
                                    }
                                    else
                                    {
                                        <MudText>Guardar</MudText>
                                    }
                                </MudButton>
                            </MudPaper>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudPaper Elevation="0" Class="p-4 mt-2">
                            <MudText Typo="Typo.h6">Logos</MudText>
                            <MudSelect T="int" Label="Logo Seleccionado" Dense="true" Margin="Margin.Dense" Value="@_activeLogoId" ValueChanged="OnActivateLogoAsyncChanged">
                                @foreach (var themeLogo in _themeLogos)
                                {
                                    <MudSelectItem Value="@themeLogo.Id">@themeLogo.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudPaper>
                        <MudPaper Elevation="0" Class="d-flex align-center justify-center mud-width-full py-4 mt-2">
                            <MudButton OnClick="ActivateLogoAsync" Disabled="!_hasLogoSelectionChanged || _isActivatingThemeLogo" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" Color="Color.Error">

                                @if (_isActivatingThemeLogo)
                                {
                                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                    <MudText Class="ms-2">Activando Logo</MudText>
                                }
                                else
                                {
                                    <MudText>Activar Logo</MudText>
                                }

                            </MudButton>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>
        @* -- *@
    </MudGrid>
</MudPaper>

@code {

    /*
     * Seccion de favicon
     */
    
    private List<ThemeAsset> _themeFavicons = new List<ThemeAsset>();

    // IBrowserFile queda confinado a este componente: la capa de aplicacion/
    // persistencia (IThemeFaviconService/IThemeFileStorageService) ya no lo
    // conoce, solo recibe un ThemeAssetFileContent con el contenido ya leido.
    private byte[]? _faviconFileBytes;
    private string? _faviconFileName;
    private string? _faviconContentType;

    private string _faviconPreviewPath  = ThemeDefaultAssets.DefaultFaviconPath;
    private int _activeFaviconId;

    private bool _hasSelectionChanged = false;
    private bool _isSavingThemeFavicon = false;
    private bool _isActivatingThemeFavicon = false;

    protected async override Task OnInitializedAsync()
    {
        try
        {
            await LoadFaviconAsync();
            await LoadLogoAsync();
        }
        catch (Exception)
        {
            SnackbarService.Add("No se pudo cargar la configuracion de favicon/logo.", Severity.Error);
        }
    }

    private async Task LoadFaviconAsync()
    {
        _themeFavicons = await ThemeFaviconService.GetAllAsync();

        if (_themeFavicons.Count() > 0)
        {
            ThemeAsset themeFaviconTemp = _themeFavicons.FirstOrDefault(t => t.IsActive);

            if(themeFaviconTemp != null)
            {
                _faviconPreviewPath = themeFaviconTemp.Path;
                _activeFaviconId = themeFaviconTemp.Id;

                StateHasChanged();
            }                
        }
    }

    private async Task UploadFiles(InputFileChangeEventArgs args)
    {
        var file = args.File;

        if (file.Size > Options.MaxUploadSizeBytes)
        {
            SnackbarService.Add($"El archivo supera el tamaño maximo permitido ({Options.MaxUploadSizeBytes / 1024 / 1024} MB).", Severity.Warning);
            return;
        }

        var buffer = new byte[file.Size];

        await using (var stream = file.OpenReadStream(Options.MaxUploadSizeBytes))
        {
            await stream.ReadAsync(buffer);
        }

        _faviconFileBytes = buffer;
        _faviconFileName = file.Name;
        _faviconContentType = file.ContentType;

        _faviconPreviewPath = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}";
    }
    
    private void resetUploadFile()
    {
        _faviconFileBytes = null;
        _faviconFileName = null;
        _faviconContentType = null;
    }

    private async Task SaveFaviconAsync()
    {
        if (_faviconFileBytes is null || _faviconFileName is null)
        {
            return;
        }

        _isSavingThemeFavicon = true;

        try
        {
            var content = new ThemeAssetFileContent(
                new MemoryStream(_faviconFileBytes),
                _faviconFileName,
                _faviconContentType ?? "application/octet-stream",
                _faviconFileBytes.Length);

            ThemeAsset newThemeFavicon = await ThemeFaviconService.CreateAsync(new ThemeAsset
            {
                Name = _faviconFileName
            },
                content
            );

            _themeFavicons.Add(newThemeFavicon);

            resetUploadFile();

            SnackbarService.Add(
                @<div>
                    <h3>Éxito</h3>
                    <ul>
                        <li>Se guardo el favicon con éxito</li>
                    </ul>
                </div>
        ,
                Severity.Success,
                config =>
                {
                    config.RequireInteraction = true;
                    config.ShowCloseIcon = true;
                }
            );
        }
        catch (ThemeValidationException ex)
        {
            SnackbarService.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            SnackbarService.Add("No se pudo guardar el favicon. Intenta nuevamente.", Severity.Error);
        }
        finally
        {
            _isSavingThemeFavicon = false;
        }
    }
   
    private void OnActivateFaviconAsyncChanged(int newValue)
    {
        _faviconPreviewPath  = _themeFavicons.FirstOrDefault(t => t.Id == newValue)?.Path;
        _activeFaviconId = newValue;

        int faviconActiveId = _themeFavicons.FirstOrDefault(t => t.IsActive)?.Id ?? 0;

        if (faviconActiveId != newValue)
        {
            _hasSelectionChanged = true;
        }
        else
        {            
            _hasSelectionChanged = false;
        }

        StateHasChanged();
    }

    private async Task ActivateFaviconAsync()
    {
        _isActivatingThemeFavicon = true;

        try
        {
            _themeFavicons = await ThemeFaviconService.ActivateAsync(_activeFaviconId);

            _hasSelectionChanged = false;

            SnackbarService.Add(
                @<div>
                    <h3>Éxito</h3>
                    <ul>
                        <li>Se activo el favicon con éxito</li>
                    </ul>
                </div>,
                Severity.Success,
                config =>
                {
                    config.RequireInteraction = true;
                    config.ShowCloseIcon = true;
                }
            );
        }
        catch (Exception)
        {
            SnackbarService.Add("No se pudo activar el favicon. Intenta nuevamente.", Severity.Error);
        }
        finally
        {
            _isActivatingThemeFavicon = false;
        }
    }    

    /*
     * 
     */

    /*
     * Seccion de Logotipo
     */

    private List<ThemeAsset> _themeLogos = new List<ThemeAsset>();

    private byte[]? _logoFileBytes;
    private string? _logoFileName;
    private string? _logoContentType;

    private string _logoPreviewPath = ThemeDefaultAssets.DefaultLogoPath;
    private int _activeLogoId;

    private bool _hasLogoSelectionChanged = false;
    private bool _isSavingThemeLogo = false;
    private bool _isActivatingThemeLogo = false;

    private async Task LoadLogoAsync()
    {
        _themeLogos = await ThemeLogoService.GetAllAsync();

        if (_themeLogos.Count() > 0)
        {
            ThemeAsset themeLogoTemp = _themeLogos.FirstOrDefault(t => t.IsActive)!;

            if (themeLogoTemp != null)
            {
                _logoPreviewPath = themeLogoTemp.Path;
                _activeLogoId = themeLogoTemp.Id;

                StateHasChanged();
            }                
        }
    }

    private async Task UploadLogoFile(InputFileChangeEventArgs args)
    {
        var file = args.File;

        if (file.Size > Options.MaxUploadSizeBytes)
        {
            SnackbarService.Add($"El archivo supera el tamaño maximo permitido ({Options.MaxUploadSizeBytes / 1024 / 1024} MB).", Severity.Warning);
            return;
        }

        var buffer = new byte[file.Size];

        await using (var stream = file.OpenReadStream(Options.MaxUploadSizeBytes))
        {
            await stream.ReadAsync(buffer);
        }

        _logoFileBytes = buffer;
        _logoFileName = file.Name;
        _logoContentType = file.ContentType;

        _logoPreviewPath = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}";
    }

    private void resetUploadLogoFile()
    {
        _logoFileBytes = null;
        _logoFileName = null;
        _logoContentType = null;
    }

    private async Task SaveLogoAsync()
    {
        if (_logoFileBytes is null || _logoFileName is null)
        {
            return;
        }

        _isSavingThemeLogo = true;

        try
        {
            var content = new ThemeAssetFileContent(
                new MemoryStream(_logoFileBytes),
                _logoFileName,
                _logoContentType ?? "application/octet-stream",
                _logoFileBytes.Length);

            ThemeAsset newThemeLogo = await ThemeLogoService.CreateAsync(new ThemeAsset
            {
                Name = _logoFileName
            },
                content
            );

            _themeLogos.Add(newThemeLogo);

            resetUploadLogoFile();

            SnackbarService.Add(
                @<div>
                    <h3>Éxito</h3>
                    <ul>
                        <li>Se guardo el logo con éxito</li>
                    </ul>
                </div>,
                Severity.Success,
                config =>
                {
                    config.RequireInteraction = true;
                    config.ShowCloseIcon = true;
                }
            );
        }
        catch (ThemeValidationException ex)
        {
            SnackbarService.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            SnackbarService.Add("No se pudo guardar el logo. Intenta nuevamente.", Severity.Error);
        }
        finally
        {
            _isSavingThemeLogo = false;
        }
    }

    private void OnActivateLogoAsyncChanged(int newValue)
    {
        _logoPreviewPath = _themeLogos.FirstOrDefault(t => t.Id == newValue)?.Path;
        _activeLogoId = newValue;

        int logoActiveId = _themeLogos.FirstOrDefault(t => t.IsActive)?.Id ?? 0;

        if (logoActiveId != newValue)
        {
            _hasLogoSelectionChanged = true;
        }
        else
        {
            _hasLogoSelectionChanged = false;
        }

        StateHasChanged();
    }

    private async Task ActivateLogoAsync()
    {
        _isActivatingThemeLogo = true;

        try
        {
            _themeLogos = await ThemeLogoService.ActivateAsync(_activeLogoId);

            _hasLogoSelectionChanged = false;

            SnackbarService.Add(
                @<div>
                    <h3>Éxito</h3>
                    <ul>
                        <li>Se activo el logo con éxito</li>
                    </ul>
                </div>,
                Severity.Success,
                config =>
                {
                    config.RequireInteraction = true;
                    config.ShowCloseIcon = true;
                }
            );
        }
        catch (Exception)
        {
            SnackbarService.Add("No se pudo activar el logo. Intenta nuevamente.", Severity.Error);
        }
        finally
        {
            _isActivatingThemeLogo = false;
        }
    }

    /*
     *
     */

}
