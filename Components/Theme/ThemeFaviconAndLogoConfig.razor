@using SAMACDX.ThemeManager.Persistence.Interfaces.Services.Theme
@using SAMACDX.ThemeManager.Persistence.Interfaces.Services
@using SAMACDX.ThemeManager.Persistence.Entities.ThemeCatalog
@using SAMACDX.ThemeManager.Persistence.Application
@using SAMACDX.ThemeManager.Persistence.Extensions
@using SAMACDX.ThemeManager.Persistence.StaticAssets
@using SAMACDX.ThemeManager.Persistence.Utilities
@using System.Text.Json

@inject IThemeFaviconService ThemeFaviconService;
@inject IThemeLogoService ThemeLogoService;
@inject ThemeManagerPersistenceOptions Options
@inject ISnackbar SnackbarService
@inject IDialogService DialogService
@inject IThemePresentService ThemePresentService

<MudPaper Elevation="0" Class="pa-4">
    <MudGrid Spacing="6">
        @* Columna informativa *@
        <MudItem xs="12" md="3">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1"><b>Favicon y logotipo</b></MudText>

                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Personaliza el favicon y logotipos de la plataforma para alinear la identidad visual con la de tu institución o marca.
                </MudText>

                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Al guardar un favicon o logotipo, estos se almacenarán dentro de la <b>Configuración Visual</b> seleccionada en el <b>Configurador de Tema Visual</b>.
                </MudText>

                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    Recomendación: usa archivos <b>SVG</b> para mejor calidad y escalabilidad.
                </MudAlert>
            </MudStack>
        </MudItem>

        @* Tarjetas de Favicon y Logo *@
        <MudItem xs="12" md="9">
            <MudGrid Spacing="4">
                @* Sección de Favicon *@
                <MudItem xs="12" sm="6">
                    <MudCard Outlined="true">
                        <MudCardHeader Class="pb-0">
                            <CardHeaderContent>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.subtitle1"><b>Favicon</b></MudText>
                                    <MudChip T="string" Size="Size.Small" Color="@(_faviconFileBytes != null || _hasSelectionChanged ? Color.Warning : Color.Success)">
                                        @(_faviconFileBytes != null ? "Sin guardar" : _hasSelectionChanged ? "Selección sin activar" : "Activo")
                                    </MudChip>
                                </MudStack>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center">
                                <MudPaper Outlined="true" Class="d-flex align-center justify-center pa-2" Style="width:100px; height:100px; flex:0 0 100px; overflow:hidden;">
                                    <MudImage Src="@_faviconPreviewPath" Alt="Favicon preview" Height="100" Class="rounded-lg d-block" Style="width:100%; object-fit:contain;" />
                                </MudPaper>
                                <MudStack Spacing="1" Class="flex-grow-1" Style="min-width:0;">
                                    <MudText Typo="Typo.body2"><b>@(_themeFavicons.FirstOrDefault(f => f.Id == _activeFaviconId)?.Name ?? "Favicon por defecto")</b></MudText>
                                    <MudSelect T="int" Label="Favicon guardado" Dense="true" Margin="Margin.Dense" Value="@_activeFaviconId" ValueChanged="OnActivateFaviconAsyncChanged">
                                        @foreach (var themeIcon in _themeFavicons)
                                        {
                                            <MudSelectItem Value="@themeIcon.Id">@themeIcon.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudStack>
                            </MudStack>
                        </MudCardContent>
                        <MudCardActions Class="px-4 pb-3 pt-0">
                            <MudFileUpload T="IBrowserFile" OnFilesChanged="UploadFiles" Accept="image/*">
                                <ActivatorContent>
                                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Upload" Size="Size.Small">Reemplazar</MudButton>
                                </ActivatorContent>
                            </MudFileUpload>
                            <MudButton Disabled="_faviconFileBytes == null || _isSavingThemeFavicon" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveFaviconAsync" Size="Size.Small" Color="Color.Primary" Class="ml-2">
                                @if (_isSavingThemeFavicon)
                                {
                                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                    <MudText Class="ms-2">Guardando</MudText>
                                }
                                else
                                {
                                    <MudText>Guardar</MudText>
                                }
                            </MudButton>
                            <MudButton OnClick="ActivateFaviconAsync" Disabled="!_hasSelectionChanged || _isActivatingThemeFavicon" Variant="Variant.Text" Size="Size.Small" Color="Color.Primary">
                                @if (_isActivatingThemeFavicon)
                                {
                                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                    <MudText Class="ms-2">Activando</MudText>
                                }
                                else
                                {
                                    <MudText>Activar</MudText>
                                }
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
                @* -- *@

                @* Sección de Logotipo *@
                <MudItem xs="12" sm="6">
                    <MudCard Outlined="true">
                        <MudCardHeader Class="pb-0">
                            <CardHeaderContent>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.subtitle1"><b>Logotipo</b></MudText>
                                    <MudChip T="string" Size="Size.Small" Color="@(_logoFileBytes != null || _hasLogoSelectionChanged ? Color.Warning : Color.Success)">
                                        @(_logoFileBytes != null ? "Sin guardar" : _hasLogoSelectionChanged ? "Selección sin activar" : "Activo")
                                    </MudChip>
                                </MudStack>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center">
                                <MudPaper Outlined="true" Class="d-flex align-center justify-center pa-2" Style="width:100px; height:100px; flex:0 0 100px; overflow:hidden;">
                                    <MudImage Src="@_logoPreviewPath" Alt="Logotipo preview" Height="100" Class="rounded-lg d-block" Style="width:100%; object-fit:contain;" />
                                </MudPaper>
                                <MudStack Spacing="1" Class="flex-grow-1" Style="min-width:0;">
                                    <MudText Typo="Typo.body2"><b>@(_themeLogos.FirstOrDefault(l => l.Id == _activeLogoId)?.Name ?? "Logotipo por defecto")</b></MudText>
                                    <MudSelect T="int" Label="Logo guardado" Dense="true" Margin="Margin.Dense" Value="@_activeLogoId" ValueChanged="OnActivateLogoAsyncChanged">
                                        @foreach (var themeLogo in _themeLogos)
                                        {
                                            <MudSelectItem Value="@themeLogo.Id">@themeLogo.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudStack>
                            </MudStack>
                        </MudCardContent>
                        <MudCardActions Class="px-4 pb-3 pt-0">
                            <MudFileUpload T="IBrowserFile" OnFilesChanged="UploadLogoFile" Accept="image/png,image/jpeg">
                                <ActivatorContent>
                                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Upload" Size="Size.Small">Reemplazar</MudButton>
                                </ActivatorContent>
                            </MudFileUpload>
                            <MudButton Disabled="_logoFileBytes == null || _isSavingThemeLogo" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveLogoAsync" Size="Size.Small" Color="Color.Primary" Class="ml-2">
                                @if (_isSavingThemeLogo)
                                {
                                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                    <MudText Class="ms-2">Guardando</MudText>
                                }
                                else
                                {
                                    <MudText>Guardar</MudText>
                                }
                            </MudButton>
                            <MudButton OnClick="ActivateLogoAsync" Disabled="!_hasLogoSelectionChanged || _isActivatingThemeLogo" Variant="Variant.Text" Size="Size.Small" Color="Color.Primary">
                                @if (_isActivatingThemeLogo)
                                {
                                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                    <MudText Class="ms-2">Activando</MudText>
                                }
                                else
                                {
                                    <MudText>Activar</MudText>
                                }
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
                @* -- *@
            </MudGrid>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Elevation="0" Class="pa-4">
    <MudGrid Spacing="6">
        <MudItem xs="12" md="3">
            <MudStack Spacing="2">
            </MudStack>
        </MudItem>
        <MudItem xs="12" md="9">
            <MudPaper Elevation="0" Outlined="true" Class="px-6 pt-8">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h6">Configuraciones visuales guardadas</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => StartCreateNew.InvokeAsync(true))">
                        Nueva Configuración
                    </MudButton>
                </MudStack>
                <MudTable T="ThemePresent" Items="@themePresents" Hover="true" Elevation="0" Dense="false">
                    <HeaderContent>
                        <MudTh></MudTh>
                        <MudTh></MudTh>
                        <MudTh Style="width:56px;"></MudTh>
                    </HeaderContent>            
                    <RowTemplate>
                        <MudTd DataLabel="Configuración">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                <MudStack Row="true" Spacing="1">
                                    @foreach (var color in GetSwatchColors(context.Id))
                                    {
                                        <div style="@($"width:16px;height:16px;border-radius:50%;background:{color};flex:0 0 auto;")"></div>
                                    }
                                </MudStack>
                                <MudText>@context.Name</MudText>
                            </MudStack>
                        </MudTd>
                        <MudTd DataLabel="Estado">
                            @if (context.IsActive)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Activo</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Filled">Guardado</MudChip>
                            }
                        </MudTd>
                        <MudTd>
                            <div @onclick:stopPropagation="true">
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                    <MudMenuItem Label="Actualizar" OnClick="@(() => UpdateFromTable(context))" />
                                    <MudMenuItem Label="Activar" Disabled="@context.IsActive" OnClick="@(() => ActivateFromTable(context.Id))" />
                                    <MudMenuItem Label="Eliminar" Disabled="@(context.IsBase || context.IsActive)" OnClick="@(() => DeleteFromTable(context))" />
                                </MudMenu>
                            </div>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Color="Color.Secondary">Todavía no hay configuraciones guardadas.</MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {

    /*
     * Seccion de favicon
     */
    
    private List<ThemeAsset> _themeFavicons = new List<ThemeAsset>();

    // IBrowserFile queda confinado a este componente: la capa de aplicacion/
    // persistencia (IThemeFaviconService/IThemeFileStorageService) ya no lo
    // conoce, solo recibe un ThemeAssetFileContent con el contenido ya leido.
    private byte[]? _faviconFileBytes;
    private string? _faviconFileName;
    private string? _faviconContentType;

    private string _faviconPreviewPath  = ThemeDefaultAssets.DefaultFaviconPath;
    private int _activeFaviconId;

    private bool _hasSelectionChanged = false;
    private bool _isSavingThemeFavicon = false;
    private bool _isActivatingThemeFavicon = false;

    private sealed record UploadedAsset(byte[] Bytes, string FileName, string ContentType);

    private async Task<UploadedAsset?> ReadUploadedAssetAsync(IBrowserFile file)
    {
        if (file.Size > Options.MaxUploadSizeBytes)
        {
            SnackbarService.Add($"El archivo supera el tamaño maximo permitido ({Options.MaxUploadSizeBytes / 1024 / 1024} MB).", Severity.Warning);
            return null;
        }

        var buffer = new byte[file.Size];

        await using var stream = file.OpenReadStream(Options.MaxUploadSizeBytes);
        await stream.ReadAsync(buffer);

        return new UploadedAsset(buffer, file.Name, file.ContentType);
    }

    private static string BuildPreviewPath(UploadedAsset uploadedAsset)
        => $"data:{uploadedAsset.ContentType};base64,{Convert.ToBase64String(uploadedAsset.Bytes)}";

    private static ThemeAssetFileContent CreateAssetContent(UploadedAsset uploadedAsset)
        => new(new MemoryStream(uploadedAsset.Bytes), uploadedAsset.FileName, uploadedAsset.ContentType, uploadedAsset.Bytes.Length);

    private void ShowSuccessMessage(string message)
    {
        SnackbarService.Add(
            message,
            Severity.Success,
            config =>
            {
                config.RequireInteraction = true;
                config.ShowCloseIcon = true;
            });
    }

    protected async override Task OnInitializedAsync()
    {
        try
        {
            await LoadFaviconAsync();
            await LoadLogoAsync();
            await GetThemePresents();
        }
        catch (Exception)
        {
            SnackbarService.Add("No se pudo cargar la configuracion de favicon/logo.", Severity.Error);
        }
    }

    private async Task LoadFaviconAsync()
    {
        _themeFavicons = await ThemeFaviconService.GetAllAsync();

        if (_themeFavicons.Count > 0)
        {
            var themeFaviconTemp = _themeFavicons.FirstOrDefault(t => t.IsActive);

            if (themeFaviconTemp is not null)
            {
                _faviconPreviewPath = themeFaviconTemp.Path;
                _activeFaviconId = themeFaviconTemp.Id;

                StateHasChanged();
            }                
        }
    }

    private async Task UploadFiles(InputFileChangeEventArgs args)
    {
        var uploadedAsset = await ReadUploadedAssetAsync(args.File);

        if (uploadedAsset is null)
        {
            return;
        }

        _faviconFileBytes = uploadedAsset.Bytes;
        _faviconFileName = uploadedAsset.FileName;
        _faviconContentType = uploadedAsset.ContentType;

        _faviconPreviewPath = BuildPreviewPath(uploadedAsset);
    }
    
    private void ResetFaviconUploadState()
    {
        _faviconFileBytes = null;
        _faviconFileName = null;
        _faviconContentType = null;
    }

    private async Task SaveFaviconAsync()
    {
        if (_faviconFileBytes is null || _faviconFileName is null)
        {
            return;
        }

        _isSavingThemeFavicon = true;

        try
        {
            var uploadedAsset = new UploadedAsset(_faviconFileBytes, _faviconFileName, _faviconContentType ?? "application/octet-stream");
            var content = CreateAssetContent(uploadedAsset);

            ThemeAsset newThemeFavicon = await ThemeFaviconService.CreateAsync(new ThemeAsset
            {
                Name = _faviconFileName
            },
                content
            );

            _themeFavicons.Add(newThemeFavicon);

            ResetFaviconUploadState();

            ShowSuccessMessage("Se guardó el favicon con éxito.");
        }
        catch (ThemeValidationException ex)
        {
            SnackbarService.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            SnackbarService.Add("No se pudo guardar el favicon. Intenta nuevamente.", Severity.Error);
        }
        finally
        {
            _isSavingThemeFavicon = false;
        }
    }
   
    private void OnActivateFaviconAsyncChanged(int newValue)
    {
        _faviconPreviewPath = _themeFavicons.FirstOrDefault(t => t.Id == newValue)?.Path ?? ThemeDefaultAssets.DefaultFaviconPath;
        _activeFaviconId = newValue;

        _hasSelectionChanged = _themeFavicons.FirstOrDefault(t => t.IsActive)?.Id != newValue;

        StateHasChanged();
    }

    private async Task ActivateFaviconAsync()
    {
        _isActivatingThemeFavicon = true;

        try
        {
            _themeFavicons = await ThemeFaviconService.ActivateAsync(_activeFaviconId);

            _hasSelectionChanged = false;

            ShowSuccessMessage("Se activó el favicon con éxito.");
        }
        catch (Exception)
        {
            SnackbarService.Add("No se pudo activar el favicon. Intenta nuevamente.", Severity.Error);
        }
        finally
        {
            _isActivatingThemeFavicon = false;
        }
    }    

    /*
     * 
     */

    /*
     * Seccion de Logotipo
     */

    private List<ThemeAsset> _themeLogos = new List<ThemeAsset>();

    private byte[]? _logoFileBytes;
    private string? _logoFileName;
    private string? _logoContentType;

    private string _logoPreviewPath = ThemeDefaultAssets.DefaultLogoPath;
    private int _activeLogoId;

    private bool _hasLogoSelectionChanged = false;
    private bool _isSavingThemeLogo = false;
    private bool _isActivatingThemeLogo = false;

    private async Task LoadLogoAsync()
    {
        _themeLogos = await ThemeLogoService.GetAllAsync();

        if (_themeLogos.Count > 0)
        {
            var themeLogoTemp = _themeLogos.FirstOrDefault(t => t.IsActive);

            if (themeLogoTemp is not null)
            {
                _logoPreviewPath = themeLogoTemp.Path;
                _activeLogoId = themeLogoTemp.Id;

                StateHasChanged();
            }                
        }
    }

    private async Task UploadLogoFile(InputFileChangeEventArgs args)
    {
        var uploadedAsset = await ReadUploadedAssetAsync(args.File);

        if (uploadedAsset is null)
        {
            return;
        }

        _logoFileBytes = uploadedAsset.Bytes;
        _logoFileName = uploadedAsset.FileName;
        _logoContentType = uploadedAsset.ContentType;

        _logoPreviewPath = BuildPreviewPath(uploadedAsset);
    }

    private void ResetLogoUploadState()
    {
        _logoFileBytes = null;
        _logoFileName = null;
        _logoContentType = null;
    }

    private async Task SaveLogoAsync()
    {
        if (_logoFileBytes is null || _logoFileName is null)
        {
            return;
        }

        _isSavingThemeLogo = true;

        try
        {
            var uploadedAsset = new UploadedAsset(_logoFileBytes, _logoFileName, _logoContentType ?? "application/octet-stream");
            var content = CreateAssetContent(uploadedAsset);

            ThemeAsset newThemeLogo = await ThemeLogoService.CreateAsync(new ThemeAsset
            {
                Name = _logoFileName
            },
                content
            );

            _themeLogos.Add(newThemeLogo);

            ResetLogoUploadState();

            ShowSuccessMessage("Se guardó el logotipo con éxito.");
        }
        catch (ThemeValidationException ex)
        {
            SnackbarService.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            SnackbarService.Add("No se pudo guardar el logo. Intenta nuevamente.", Severity.Error);
        }
        finally
        {
            _isSavingThemeLogo = false;
        }
    }

    private void OnActivateLogoAsyncChanged(int newValue)
    {
        _logoPreviewPath = _themeLogos.FirstOrDefault(t => t.Id == newValue)?.Path ?? ThemeDefaultAssets.DefaultLogoPath;
        _activeLogoId = newValue;

        _hasLogoSelectionChanged = _themeLogos.FirstOrDefault(t => t.IsActive)?.Id != newValue;

        StateHasChanged();
    }

    private async Task ActivateLogoAsync()
    {
        _isActivatingThemeLogo = true;

        try
        {
            _themeLogos = await ThemeLogoService.ActivateAsync(_activeLogoId);

            _hasLogoSelectionChanged = false;

            ShowSuccessMessage("Se activó el logotipo con éxito.");
        }
        catch (Exception)
        {
            SnackbarService.Add("No se pudo activar el logo. Intenta nuevamente.", Severity.Error);
        }
        finally
        {
            _isActivatingThemeLogo = false;
        }
    }

    /*
     *
     * Seccion de Configuraciones Visuales
     */

    [Parameter]
    public EventCallback<bool> StartCreateNew { get; set; }

    [Parameter]
    public EventCallback<ThemePresent> SelectThemePresent { get; set; }

    private Dictionary<int, List<string>> _swatchColors = new Dictionary<int, List<string>>();

    private List<ThemePresent> themePresents = new List<ThemePresent>();    
    

    private List<string> GetSwatchColors(int themePresentId) => _swatchColors.TryGetValue(themePresentId, out var colors) ? colors : new List<string>();

    private async Task ActivateFromTable(int id)
    {
        try
        {
            await ActivateThemePresent(id);
        }
        catch (Exception)
        {
            SnackbarService.Add("No se pudo activar el tema. Intenta nuevamente.", Severity.Error);
        }
    }

    private async Task UpdateFromTable(ThemePresent themePresent)
    {
        await SelectThemePresent.InvokeAsync(themePresent);
    }

    private async Task DeleteFromTable(ThemePresent themePresent)
    {
        bool? confirmed = await DialogService.ShowMessageBox(
            "Eliminar configuración",
            $"¿Eliminar \"{themePresent.Name}\"? Esta acción no se puede deshacer.",
            yesText: "Eliminar",
            cancelText: "Cancelar");

        if (confirmed != true)
        {
            return;
        }

        try
        {
            await ThemePresentService.DeleteAsync(themePresent.Id);

            themePresents.RemoveAll(t => t.Id == themePresent.Id);        
            _swatchColors.Remove(themePresent.Id);

            SnackbarService.Add("Configuración eliminada.", Severity.Success);
        }
        catch (ThemeValidationException ex)
        {
            SnackbarService.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            SnackbarService.Add("No se pudo eliminar la configuracion. Intenta nuevamente.", Severity.Error);
        }
    }

    private async Task GetThemePresents()
    {
        themePresents = await ThemePresentService.GetAllAsync();

        _swatchColors = themePresents.ToDictionary(themePresent => themePresent.Id,themePresent => ExtractSwatchColors(themePresent.JsonData));
    }

    private List<string> ExtractSwatchColors(string? jsonData)
    {
        if (string.IsNullOrWhiteSpace(jsonData))
        {
            return new List<string>();
        }

        try
        {
            var theme = JsonHelper.Deserialize<ThemeManagerTheme>(jsonData);
            var palette = theme?.Theme?.PaletteLight;

            if (palette is null)
            {
                return new List<string>();
            }

            return new List<string>
            {
                palette.Primary.ToString(),
                palette.Secondary.ToString(),
                palette.Tertiary.ToString(),
                palette.Error.ToString(),
            };
        }
        catch (Exception)
        {
            return new List<string>();
        }
    }

    private async Task ActivateThemePresent(int id)
    {
        themePresents = await ThemePresentService.ActivateAsync(id);

        var selectedThemePresent = themePresents.FirstOrDefault(t => t.Id == id);
        if (selectedThemePresent is not null)
        {
            await SelectThemePresent.InvokeAsync(selectedThemePresent);
        }

        _swatchColors = themePresents.ToDictionary(
            themePresent => themePresent.Id,
            themePresent => _swatchColors.TryGetValue(themePresent.Id, out var colors) ? colors : ExtractSwatchColors(themePresent.JsonData)
        );
    }




}
