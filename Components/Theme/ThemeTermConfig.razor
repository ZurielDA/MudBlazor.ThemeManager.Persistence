@using SAMACDX.ThemeManager.Persistence.Interfaces.Services.Theme
@using SAMACDX.ThemeManager.Persistence.Entities.Theme
@using SAMACDX.ThemeManager.Persistence.Application

@inject IThemeTermService ThemeTermService
@inject ITermService TermService
@inject ISnackbar SnackbarService

<MudPaper Class="" Style="overflow:hidden; position:relative;">

    <MudPaper Class="mx-6" Elevation="0">       

        <MudStack Spacing="2">
            <MudText Typo="Typo.h4">
                Configurador de Terminología
            </MudText>

            <MudText Typo="Typo.body1">
                Personaliza los términos utilizados en la plataforma, ajustando nombres, singular/plural, género y expresiones especiales.
                Los cambios permiten adaptar la terminología a los estándares institucionales o preferencias del usuario, asegurando consistencia en toda la interfaz.
            </MudText>

            <MudText Typo="Typo.body2">
                Esta configuración es <b>independiente del Tema Visual</b> y se aplica únicamente a los textos de la plataforma.
                Los únicos campos que pueden modificarse son los de la columna <b>Singular</b>, <b>Plural</b>, <b>Género</b> y <b>Especial</b>.
                Para realizar una modificación, haz <b>clic en la celda</b>, edita el texto y luego selecciona cualquier área externa de la tabla para que el cambio se <b>guarde automáticamente</b>.
            </MudText>

            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Nota: las columnas modificables se encuentran <b>resaltadas con un color</b> para que sea más fácil identificarlas visualmente.
            </MudText>
        </MudStack>

    </MudPaper>

    <MudDataGrid Class="mx-6" T="ThemeTerm" Items="@themeTerms" SortMode="SortMode.Multiple" Filterable="true" ReadOnly="false" EditMode="DataGridEditMode.Cell"
                 CommittedItemChanges="@CommittedItemChanges"
                 EditTrigger="DataGridEditTrigger.OnRowClick" QuickFilter="@_quickFilter" Hideable="true" Hover="@_hover" Dense="true">

        <ToolBarContent>
            <MudText Typo="Typo.h6">Terminos del Sistema</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString" Placeholder="Buscar" Adornment="Adornment.Start" Immediate="true"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>
        <ColGroup>
            <col />
            <col />
            <col style="background: var(--mud-palette-tertiary); brightness(50%);" />
            <col style="background: var(--mud-palette-tertiary);" />
            @* <col style="background: var(--mud-palette-tertiary);" /> *@
            @* <col style="background: var(--mud-palette-tertiary);" /> *@
        </ColGroup>
        <Columns>
            <TemplateColumn Title="#" Sortable="true" Editable="false">
                <CellTemplate>
                    <MudText>@(themeTerms.IndexOf(context.Item) + 1)</MudText>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Key" Title="Identificador" Editable="false" />
            <PropertyColumn Property="x => x.Singular" Title="Singular ✎" />
            <PropertyColumn Property="x => x.Plural" Title="Plural ✎" />
            @* <PropertyColumn Property="x => x.Gender" Title="Genero ✎" /> *@
            @* <PropertyColumn Property="x => x.Special" Title="Especial ✎" /> *@
        </Columns>
        <PagerContent>
            <MudDataGridPager T="ThemeTerm" />
        </PagerContent>
    </MudDataGrid>

</MudPaper>

@code {

    private string _searchString = string.Empty;
    private bool _hover = true;
    private List<ThemeTerm> themeTerms = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            themeTerms = await ThemeTermService.GetAllTermsAsync();
        }
        catch (Exception)
        {
            SnackbarService.Add("No se pudo cargar la terminologia.", Severity.Error);
        }
    }

    private Func<ThemeTerm, bool> _quickFilter => term => string.IsNullOrWhiteSpace(_searchString) || MatchesSearch(term, _searchString);

    private static bool MatchesSearch(ThemeTerm term, string searchString)
    {
        return term.Key.Contains(searchString, StringComparison.OrdinalIgnoreCase)
            || term.Singular.Contains(searchString, StringComparison.OrdinalIgnoreCase)
            || term.Plural.Contains(searchString, StringComparison.OrdinalIgnoreCase)
            || term.Gender.Contains(searchString, StringComparison.OrdinalIgnoreCase)
            || term.Special.Contains(searchString, StringComparison.OrdinalIgnoreCase);
    }

    // Antes era "async void": la excepcion mas grave posible en C# async,
    // porque queda completamente inobservada (ni siquiera un try/catch
    // alrededor de la llamada la atrapa). Ahora es "async Task" (el
    // EventCallback de MudDataGrid admite ambas firmas) con manejo de
    // errores explicito.
    public async Task CommittedItemChanges(ThemeTerm item)
    {
        try
        {
            await ThemeTermService.UpdateTermsAsync(item);
            TermService.InvalidateCache();
        }
        catch (ThemeValidationException ex)
        {
            SnackbarService.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            SnackbarService.Add("No se pudo guardar el termino. Intenta nuevamente.", Severity.Error);
        }
    }
}
