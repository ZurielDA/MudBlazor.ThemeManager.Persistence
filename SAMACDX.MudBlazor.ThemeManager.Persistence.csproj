<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- RootNamespace is deliberately NOT "SAMACDX.MudBlazor.ThemeManager.Persistence":
		     that would embed "MudBlazor.ThemeManager" as a literal nested namespace path,
		     which shadows the real global MudBlazor / MudBlazor.ThemeManager namespaces
		     (from the MudBlazor package and the MudBlazor.ThemeManager submodule) for any
		     code inside this library that references them unqualified - causes CS0246/CS0234
		     (ISnackbar, ThemeManagerTheme, MudThemeManager "not found"). AssemblyName keeps
		     the full library/package name; only RootNamespace differs. -->
		<RootNamespace>SAMACDX.ThemeManager.Persistence</RootNamespace>
		<AssemblyName>SAMACDX.MudBlazor.ThemeManager.Persistence</AssemblyName>
	</PropertyGroup>

	<!-- Metadatos de empaquetado NuGet. Version/Authors/Description/PackageId son
	     seguros de fijar ahora (no dependen de una decision que solo el autor
	     del repositorio pueda tomar). RepositoryUrl y PackageLicenseExpression
	     se dejan sin definir deliberadamente: requieren una decision explicita
	     del propietario del repositorio (licencia real, URL real) que esta
	     etapa no puede asumir por su cuenta. -->
	<PropertyGroup>
		<Version>0.1.0</Version>
		<Authors>SAMACDX</Authors>
		<Description>Modulo reutilizable de gestion de Theme/Branding (catalogos de tema, paleta visual, favicon/logo, terminologia) para aplicaciones Blazor con MudBlazor.</Description>
		<PackageId>SAMACDX.MudBlazor.ThemeManager.Persistence</PackageId>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- Varios miembros publicos (sobre todo los heredados 1:1 de GDIP) aun no
		     tienen comentario XML propio; no se trata cada uno como error de build
		     solo por habilitar la generacion del archivo de documentacion. -->
		<NoWarn>$(NoWarn);CS1591</NoWarn>
	</PropertyGroup>

	<!-- External\MudBlazor.ThemeManager and samples\TestHost are each their own project
	     (referenced via ProjectReference below, or standalone). Without excluding them
	     here, the default SDK globbing of THIS project would ALSO compile their .razor/.cs
	     files (and even their generated obj\** artifacts) directly into this assembly,
	     producing duplicate component types (RZ9985 "Multiple components use the tag ..."),
	     duplicate assembly attributes (CS0579), and unresolved ASP.NET Core Web-only types
	     that this Razor Class Library doesn't reference (CS0234/CS0246 for Builder, Hosting,
	     Authorization, IWebHostEnvironment, etc.). GDIP's own .csproj excludes its nested
	     project folders (including this same External\MudBlazor.ThemeManager) the same way. -->
	<ItemGroup>
		<Compile Remove="External\**" />
		<Content Remove="External\**" />
		<EmbeddedResource Remove="External\**" />
		<None Remove="External\**" />

		<Compile Remove="samples\**" />
		<Content Remove="samples\**" />
		<EmbeddedResource Remove="samples\**" />
		<None Remove="samples\**" />
	</ItemGroup>

	<!-- Framework reference explicita a ASP.NET Core: esta libreria es un Razor
	     Class Library (Sdk.Razor), que por defecto NO trae acceso a tipos de
	     hosting como IWebHostEnvironment. Se agrega aqui unicamente para la
	     implementacion OPCIONAL de almacenamiento en disco
	     (Application/Assets/LocalDiskThemeFileStorageService.cs); es un
	     patron estandar y soportado para RCLs que necesitan abstracciones de
	     hosting de ASP.NET Core (el mismo mecanismo que usan, por ejemplo, las
	     paginas de Identity UI de Microsoft). No cambia el TargetFramework ni
	     requiere que el consumidor use Sdk.Web para el resto de la libreria. -->
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<!-- Microsoft.AspNetCore.Components.Web y Microsoft.Extensions.DependencyInjection.Abstractions
	     tienen el piso de su rango en 9.0.1 (no 9.0.0): MudBlazor 8.0.0 exige
	     transitivamente Components.Web >= 9.0.1 y, via Microsoft.Extensions.Localization
	     9.0.1, DependencyInjection.Abstractions >= 9.0.1. Un rango con piso 9.0.0 hace que
	     NuGet resuelva esta referencia DIRECTA a 9.0.0, lo cual es un downgrade respecto a
	     lo que el grafo transitivo ya exige (9.0.1) y falla el restore con NU1605
	     ("Warning As Error: Detected package downgrade"). El piso 9.0.1 aqui no es
	     arbitrario: es exactamente el minimo que el propio error de NU1605 senala. -->
	<ItemGroup>
		<PackageReference Include="MudBlazor" Version="[8.0.0,9.0.0)" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="[9.0.0,10.0.0)" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="[9.0.1,10.0.0)" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="[9.0.0,10.0.0)" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[9.0.1,10.0.0)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="External\MudBlazor.ThemeManager\src\MudBlazor.ThemeManager\MudBlazor.ThemeManager.csproj" />
	</ItemGroup>

</Project>
