@page "/"
@inject IThemePresentService ThemePresentService
@inject IThemeFaviconService ThemeFaviconService
@inject IThemeLogoService ThemeLogoService

<MudPaper Class="pa-6">
    <MudText Typo="Typo.h4" Class="mb-4">Estado actual del módulo Theme</MudText>

    @if (_activePresent is null)
    {
        <MudText>Cargando…</MudText>
    }
    else
    {
        <MudStack Spacing="2">
            <MudText><b>Tema activo:</b> @_activePresent.Name</MudText>
            <MudText><b>Favicon activo:</b> @(_faviconPath ?? "(ninguno)")</MudText>
            <MudText><b>Logo activo:</b> @(_logoPath ?? "(ninguno)")</MudText>
            <MudText><b>GetCurrentLogoPathAsync():</b> @(_logoPath ?? "(vacío)")</MudText>
        </MudStack>

        @if (!string.IsNullOrEmpty(_logoPath))
        {
            <MudImage Src="@_logoPath" Height="80" Class="mt-4" />
        }
    }

    <MudButton Href="/administrar-tema" Variant="Variant.Filled" Color="Color.Primary" Class="mt-6">
        Ir al administrador de Theme (/administrar-tema)
    </MudButton>
</MudPaper>

@code {
    private ThemePresent? _activePresent;
    private string? _faviconPath;
    private string? _logoPath;

    protected override async Task OnInitializedAsync()
    {
        _activePresent = await ThemePresentService.GetActiveAsync();
        _faviconPath = await ThemeFaviconService.GetCurrentFaviconPathAsync();
        _logoPath = await ThemeLogoService.GetCurrentLogoPathAsync();
    }
}
