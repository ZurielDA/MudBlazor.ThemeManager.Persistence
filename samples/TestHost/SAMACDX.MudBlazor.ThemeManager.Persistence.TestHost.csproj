<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>SAMACDX.ThemeManager.Persistence.TestHost</RootNamespace>
	</PropertyGroup>

	<!-- MudBlazor NO se referencia aquí directamente: ya llega de forma transitiva a
	     través del ProjectReference a la librería (que sí la referencia). Tenerla
	     declarada en AMBOS proyectos duplica la fuente de sus static web assets
	     (_content/MudBlazor/*), lo que hace que app.MapStaticAssets() (.NET 9) falle
	     con 500 al intentar servir MudBlazor.min.css/.js por resolución ambigua. -->
	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.*" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\SAMACDX.MudBlazor.ThemeManager.Persistence.csproj" />
	</ItemGroup>

</Project>
